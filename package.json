{
  "name": "rufus",
  "productName": "Rufus",
  "version": "4.15.0",
  "description": "The Reliable USB Formatting Utility for Linux (Portable)",
  "homepage": "https://rufus.ie",
  "desktopName": "rufus.desktop",
  "author": {
    "name": "Rufus Linux Team",
    "email": "support@rufus.ie"
  },
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --linux dir deb --publish never && bash scripts/build-true-portable.sh",
    "build:appimage": "electron-builder --linux dir && bash scripts/build-true-portable.sh",
    "build:deb": "electron-builder --linux deb --publish never"
  },
  "keywords": [
    "rufus",
    "usb",
    "bootable",
    "iso",
    "formatter",
    "linux",
    "ubuntu"
  ],
  "license": "GPL-3.0",
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "ie.rufus.rufus-linux",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "dir",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "System;Utility;",
      "syncDesktopName": true,
      "maintainer": "Rufus Linux Team <support@rufus.ie>",
      "synopsis": "Create bootable USB drives the easy way",
      "description": "Rufus is a utility that helps format and create bootable USB flash drives, such as USB keys/pendrives, memory sticks, etc."
    },
    "deb": {
      "artifactName": "rufus_4.15_amd64.deb",
      "depends": [
        "libc6",
        "parted",
        "dosfstools"
      ]
    }
  }
}
